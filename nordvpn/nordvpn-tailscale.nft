table inet nordvpn_tailscale {
	chain output {
		# After conntrack (-200), before NordVPN's output chain (mangle, -150).
		type route hook output priority -160; policy accept;

		# tailscaled's own packets: coordination server, DERP relays, STUN and
		# direct WireGuard to peers. Tailscale tags these sockets with 0x80000.
		# Re-tag them with NordVPN's mark so NordVPN's firewall accepts them and
		# its routing sends them outside the tunnel.
		meta mark & 0x00ff0000 == 0x00080000 counter ct mark set 0x0000e1f1 meta mark set 0x0000e1f1

		# Tailnet traffic leaving through tailscale0 (routing is unchanged).
		oifname "tailscale0" counter ct mark set 0x0000e1f1
	}

	chain input {
		# Before NordVPN's input chain (filter, 0).
		type filter hook input priority -10; policy accept;

		# Mark only traffic that actually arrived through Tailscale.
		iifname "tailscale0" counter ct mark set 0x0000e1f1
	}
}
