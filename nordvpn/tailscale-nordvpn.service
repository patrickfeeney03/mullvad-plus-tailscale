[Unit]
Description=Allow Tailscale traffic alongside NordVPN's firewall
Documentation=https://guides.patrick.pe/posts/use-tailscale-with-nordvpn-on-linux
After=nordvpnd.service tailscaled.service
Wants=nordvpnd.service tailscaled.service

[Service]
Type=oneshot
ExecStartPre=-/usr/bin/nft delete table inet nordvpn_tailscale
ExecStart=/usr/bin/nft -f /etc/nftables.d/nordvpn-tailscale.nft
ExecReload=-/usr/bin/nft delete table inet nordvpn_tailscale
ExecReload=/usr/bin/nft -f /etc/nftables.d/nordvpn-tailscale.nft
ExecStop=-/usr/bin/nft delete table inet nordvpn_tailscale
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
